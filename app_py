import streamlit as st
from PIL import Image
import pytesseract
import re

st.title("Food Ingredient Scanner")

uploaded_file = st.file_uploader(
    "Upload image",
    type=["jpg", "jpeg", "png"]
)

harmful = [
    "e621",
    "e250",
    "e951",
    "aspartame",
    "palm oil"
]

if uploaded_file:

    image = Image.open(uploaded_file)

    st.image(image)

    text = pytesseract.image_to_string(image)

    st.subheader("OCR Text")
    st.write(text)

    text = text.lower()

    found = []

    for item in harmful:
        if item in text:
            found.append(item)

    if found:
        st.error("Detected:")
        st.write(found)
    else:
        st.success("No harmful ingredients found")
